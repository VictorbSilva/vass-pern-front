# Copie este arquivo para .env e ajuste o valor conforme o ambiente.
# O .env real NAO deve ser commitado (ja esta no .gitignore).
#
# VITE_API_URL = endereco base do backend Django.
# Informe APENAS a origem: sem barra no final e sem /api.
# O codigo monta o resto do caminho (ex.: /api/produtos/).

# Desenvolvimento local (backend Django rodando na maquina):
VITE_API_URL=http://127.0.0.1:8000

# Producao (Railway) - este e o valor que deve ser configurado
# em Environment Variables no projeto da Vercel:
# VITE_API_URL=https://vass-pern-back-production.up.railway.app
